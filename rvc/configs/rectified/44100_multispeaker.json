      "speaker_channels": 512,
      "pitch_fourier": 6,
      "harmonic_prior": true,
      "breathiness": true,
      "key_shift": true,
      "speed": true,
      "backbone": "lynxnet2",
      "backbone_args": {
        "channels": 1024,
        "layers": 6,
        "expansion": 1,
        "kernel_size": 31,
        "adaln": true,
        "time_scale": 1000.0
      },
      "aux_decoder": {
        "channels": 512,
        "layers": 6,
        "dropout": 0.1
      },
      "t_start": 0.0,
      "aux_grad": 1.0,
      "conditioning_version": 2,
      "mean_flow": false,
      "direct_speaker_conditioning": true
    },
    "finetune_preview_interval": 500,
    "speaker_balanced_sampling": true
