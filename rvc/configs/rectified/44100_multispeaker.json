{
  "data": {
    "sample_rate": 44100,
    "hop_length": 512,
    "n_fft": 2048,
    "win_length": 2048,
    "n_mels": 128,
    "mel_fmin": 40.0,
    "mel_fmax": 16000.0,
    "mel_mean": -6.0,
    "mel_std": 6.0,
    "content_interpolation": "linear"
  },
  "flow": {
    "optimizer": "muon",
    "learning_rate": 0.0005,
    "min_learning_rate": 0.0001,
    "finetune_learning_rate": 0.0001,
    "lr_final_ratio": 0.1,
    "lr_schedule": "step",
    "decay_step": 4000,
    "gamma": 0.9,
    "step_lr_offset": 0,
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.1,
    "warmup_steps": 0,
    "segment_frames": 400,
    "grad_clip": 1.0,
    "ema_decay": 0.9999,
    "finetune_ema_decay": 0.999,
    "speaker_dropout": 0.0,
    "finetune_freeze_voice": true,
    "key_shift_range": 5.0,
    "key_shift_prob": 0.43,
    "time_stretch_range": [
      0.5,
      2.0
    ],
    "time_stretch_prob": 0.43,
    "aux_mel_weight": 1.0,
    "preview_interval": 1000,
