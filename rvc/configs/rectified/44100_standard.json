{
  "preset": "standard-v1",
  "flow": {
    "learning_rate": 0.0006,
    "decay_step": 5000,
    "gamma": 0.8,
    "max_batch_frames": 50000,
    "max_batch_size": 64,
    "augmentation_max_examples": 20000,
    "num_workers": 4,
    "preview_interval": 1000,
    "eval_interval": 1000,
    "holdout_clips": 32,
    "augmentation_args": {
      "random_pitch_shifting": {
        "enabled": true,
        "range": [
          -5.0,
          5.0
        ],
        "scale": 0.75
      },
      "random_time_stretching": {
        "enabled": true,
        "range": [
          0.5,
          2.0
        ],
        "scale": 0.75
      }
    },
    "model": {
      "sampling_method": "euler",
      "sampling_steps": 20
    }
  }
}
