{
  "flow": {
    "decay_step": 3000,
    "max_updates": 30000,
    "max_batch_frames": 50000,
    "max_batch_size": 64,
    "holdout_clips": 8,
    "eval_interval": 2000,
    "preview_interval": 2000,
    "checkpoint_interval": 2000,
    "permanent_ckpt_start": 10000,
    "permanent_ckpt_interval": 5000,
    "augmentation_args": {
      "random_pitch_shifting": {
        "enabled": true
      },
      "random_time_stretching": {
        "enabled": true
      },
      "random_content_perturbation": {
        "enabled": true
      }
    },
    "model": {
      "source_filter": true,
      "hidden_channels": 384,
      "encoder_layers": 4,
      "backbone_args": {
        "channels": 1024,
        "layers": 6,
        "dropout_rate": 0.1
      },
      "aux_decoder": {
        "channels": 512,
        "layers": 6
      }
    }
  },
  "finetune": {
    "flow": {
      "finetune_learning_rate": 0.0001,
      "finetune_warmup_steps": 0,
      "min_learning_rate": 1e-05,
      "lr_schedule": "cosine",
      "max_updates": 10000,
      "eval_interval": 500,
      "checkpoint_interval": 2000
    }
  }
}
