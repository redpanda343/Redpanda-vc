{
  "flow": {
    "decay_step": 15000,
    "max_updates": 300000,
    "model": {
      "mean_flow": true,
      "hidden_channels": 256,
      "encoder_layers": 4,
      "backbone_args": {
        "channels": 512,
        "layers": 6
      },
      "dual_timestep": false,
      "t_start": 0.0,
      "t_start_infer": 0.0,
      "sampling_method": "mean",
      "sampling_steps": 2,
      "train_aux_decoder": false,
      "val_gt_start": false
    }
  },
  "finetune": {
    "flow": {
      "finetune_learning_rate": 0.00005,
      "finetune_warmup_steps": 500,
      "min_learning_rate": 0.00001,
      "decay_step": 2000,
      "eval_interval": 500,
      "augmentation_args": {
        "random_pitch_shifting": {
          "enabled": false
        },
        "random_time_stretching": {
          "enabled": false
        }
      }
    }
  }
}
